# -----------------------------------------------------------------------------
# Variabili Supabase (OPZIONALI)
# -----------------------------------------------------------------------------
# Questa app è "zero build" (Vanilla JS): non usa un bundler, quindi la
# configurazione attiva NON avviene tramite queste variabili d'ambiente ma
# tramite il file  config.js  (vedi config.example.js).
#
# Questo file .env.example serve come riferimento dei NOMI delle variabili,
# utile se in futuro deciderai di aggiungere un passo di build.
#
# Dove trovare i valori (in Supabase):
#   Dashboard del progetto  ->  Project Settings  ->  API
#     - "Project URL"      => SUPABASE_URL
#     - "anon public" key  => SUPABASE_ANON_KEY   (chiave PUBBLICA, sicura da esporre)
#
# IMPORTANTE: non inserire mai la "service_role" key nel frontend o nel repo.
# -----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
